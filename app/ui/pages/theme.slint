            background: self.has-hover ? Theme.overlay-hover : transparent;
            border-width: 1px;
            border-color: Theme.card-border;

            HorizontalLayout {
                padding: 0.75 * root.unit;
                spacing: 0.75 * root.unit;
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    Text { text: "RD+ Torrentio 1080p • 4.2 GB"; color: Theme.primary-foreground; font-size: 0.85 * root.unit; font-weight: 600; }

                    HorizontalLayout {
                        spacing: 0.4 * root.unit;

                        Image {
                            y: (parent.height - self.height) / 2;
                            width: 0.85 * root.unit;
                            height: 0.85 * root.unit;
                            source: @image-url("../assets/images/icons/cloud-sync.svg");
                            colorize: Theme.tertiary-accent;
                            image-fit: contain;
                        }

                        Text { text: "RealDebrid High Speed Cached"; color: Theme.tertiary-accent; font-size: 0.75 * root.unit; font-weight: 600; }
                    }
                }

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 1.6 * root.unit;
                    border-radius: 0.3 * root.unit;
                    background: Theme.overlay-hover;
                    border-width: 1px;
                    border-color: Theme.card-border;

                    HorizontalLayout {
                        padding-left: 0.6 * root.unit;
                        padding-right: 0.6 * root.unit;
                        Text { text: "1080p"; color: Theme.text-secondary; font-size: 0.75 * root.unit; font-weight: 600; vertical-alignment: center; }
                    }
