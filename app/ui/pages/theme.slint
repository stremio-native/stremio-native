// ── Stremio Native Card 3: Native Video Player & OSD Controls Preview ──
component StremioPlayerCard inherits StudioPreviewCard {
    property <float> progress: 0.52;

    VerticalLayout {
        padding: 1.25 * root.unit;
        spacing: 1 * root.unit;

        HorizontalLayout {
            alignment: space-between;

            Text {
                text: @tr("Player OSD Controls");
                color: Theme.primary-foreground;
                font-size: 1.1 * root.unit;
                font-weight: 700;
            }

            Text {
                text: "libmpv • Hardware Accelerated";
                color: Theme.secondary-accent;
                font-size: 0.8 * root.unit;
                font-weight: 600;
            }
        }

        // Player Canvas Preview Box
        Rectangle {
            height: 9 * root.unit;
            border-radius: Theme.compact-radius;
            background: Theme.main-gradient;
            border-width: 1px;
            border-color: Theme.card-border;

            // Player Overlay OSD Controls
            VerticalLayout {
                padding: 1 * root.unit;
                alignment: space-between;

                // OSD Top Bar
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Dune: Part Two"; color: Theme.primary-foreground; font-size: 0.9 * root.unit; font-weight: 700; }
                    Text { text: "HDR10 • 4K"; color: Theme.primary-accent; font-size: 0.8 * root.unit; font-weight: 700; }
                }

                // Center Play Icon Button
                Rectangle {
                    width: 3 * root.unit;
                    height: 3 * root.unit;
                    x: (parent.width - self.width) / 2;
                    border-radius: 1.5 * root.unit;
                    background: Theme.scrim.with-alpha(0.8);
                    border-width: 1px;
                    border-color: Theme.primary-accent;

                    Image {
                        x: (parent.width - self.width) / 2 + 1px;
                        y: (parent.height - self.height) / 2;
                        width: 1.4 * root.unit;
                        height: 1.4 * root.unit;
                        source: @image-url("../assets/images/icons/play.svg");
                        colorize: Theme.primary-foreground;
                        image-fit: contain;
                    }
                }

                // Bottom Seekbar & Time
                VerticalLayout {
                    spacing: 0.4 * root.unit;

                    Slider {
                        height: 1.5 * root.unit;
                        unit: root.unit;
                        value: 52;
                        minimum: 0;
                        maximum: 100;
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "01:24:15"; color: Theme.primary-foreground; font-size: 0.75 * root.unit; font-weight: 600; }
                        Text { text: "02:46:00"; color: Theme.text-muted; font-size: 0.75 * root.unit; }
                    }
                }
            }
        }
    }
}

