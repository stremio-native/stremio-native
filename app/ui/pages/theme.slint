import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ButtonSurface, PillButton } from "../components/button.slint";
import { ColorInput, ColorPicker } from "../components/color_input.slint";
import { ModalDialog } from "../components/overlays.slint";
import { NativeTextField } from "../components/text_input.slint";
import { SelectField } from "../components/select.slint";
import { Slider } from "../components/slider.slint";
import { ColorUtils } from "../components/color_utils.slint";
import { MediaCard, MediaCardItem } from "../components/media_card.slint";
import { Chip } from "../components/chip.slint";

struct ThemePreset {
    name: string,
    accent: color,
    background: color,
    secondary: color,
    card: color,
    border: color,
    text: color,
}

// ── Left Sidebar Accordion Category ──
component AccordionSection inherits VerticalLayout {
    in property <length> unit: 16px;
    in property <string> title;
    in-out property <bool> expanded: true;
    callback toggle;

    spacing: root.expanded ? 0.5 * root.unit : 0px;

    header := ButtonSurface {
        height: 2.2 * root.unit;
        background: transparent;
        clicked => {
            root.expanded = !root.expanded;
            root.toggle();
        }

        HorizontalLayout {
            padding-left: 0.5 * root.unit;
            padding-right: 0.5 * root.unit;
            spacing: 0.5 * root.unit;
            alignment: start;

            Image {
                y: (parent.height - self.height) / 2;
                width: 1 * root.unit;
                height: 1 * root.unit;
                source: root.expanded
                    ? @image-url("../assets/images/icons/chevron-down.svg")
                    : @image-url("../assets/images/icons/chevron-forward.svg");
                colorize: Theme.text-muted;
                image-fit: contain;
            }

            Text {
                text: root.title;
                color: Theme.text-muted;
                font-size: 0.75 * root.unit;
                font-weight: 700;
                letter-spacing: 0.05 * root.unit;
                vertical-alignment: center;
            }
        }
    }

    content-box := Rectangle {
        height: root.expanded ? content-layout.preferred-height : 0px;
        clip: true;
        visible: self.height > 0px;

        animate height { duration: 150ms; easing: ease-in-out; }

        content-layout := VerticalLayout {
            padding-left: 0.5 * root.unit;
            spacing: 0.6 * root.unit;
            @children
        }
    }
}

// ── Color Row Token inside Tweakcn Accordion ──
component TweakcnColorRow inherits HorizontalLayout {
    in property <length> unit: 16px;
    in property <string> label;
    in property <color> value;
    in property <brush> fill-brush: root.value;
    in property <bool> allow-gradient: false;
    in property <bool> is-gradient: false;
    callback edited(color);
    callback gradient-edited(brush, color, color);

    spacing: 0.75 * root.unit;
    height: 2.6 * root.unit;

    // Swatch box
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 1.6 * root.unit;
        height: 1.6 * root.unit;
        border-radius: 0.3 * root.unit;
        background: root.fill-brush;
        border-width: 1px;
        border-color: Theme.card-border;
    }

    Text {
        horizontal-stretch: 1;
        text: root.label;
        color: Theme.primary-foreground;
        font-size: 0.9 * root.unit;
        font-weight: 500;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        text: ColorUtils.hex(root.value);
        color: Theme.text-muted;
        font-size: 0.8 * root.unit;
        font-weight: 500;
        vertical-alignment: center;
    }

    ColorInput {
        y: (parent.height - self.height) / 2;
        unit: root.unit;
        width: 4.5 * root.unit;
        value: root.value;
        fill-brush: root.fill-brush;
        is-gradient: root.is-gradient;
        allow-gradient: root.allow-gradient;
        color-changed(val) => { root.edited(val); }
        gradient-changed(gradient, start, end) => { root.gradient-edited(gradient, start, end); }
    }
}

// ── Studio Preview Card Shell ──
component StudioPreviewCard inherits Rectangle {
    in property <length> unit: 16px;
    background: Theme.card-background;
    border-radius: Theme.border-radius;
    border-width: 1px;
    border-color: Theme.card-border;
    clip: true;

    @children
}

// ── Stremio Native Card 1: Featured Hero & Media Details Preview ──
component StremioMediaHeroCard inherits StudioPreviewCard {
    VerticalLayout {
        padding: 1.5 * root.unit;
        spacing: 1 * root.unit;

        HorizontalLayout {
            alignment: space-between;

            Text {
                text: "FEATURED MEDIA PREVIEW";
                color: Theme.primary-accent;
                font-size: 0.75 * root.unit;
                font-weight: 700;
                letter-spacing: 0.05 * root.unit;
            }

            Rectangle {
                height: 1.6 * root.unit;
                border-radius: 0.8 * root.unit;
                background: Theme.imdb;
                border-width: 1px;
                border-color: Theme.card-border;

                HorizontalLayout {
                    padding-left: 0.6 * root.unit;
                    padding-right: 0.6 * root.unit;
                    spacing: 0.4 * root.unit;

                    Image {
                        y: (parent.height - self.height) / 2;
                        width: 0.9 * root.unit;
                        height: 0.9 * root.unit;
                        source: @image-url("../assets/images/icons/star.svg");
                        colorize: Theme.secondary-foreground;
                        image-fit: contain;
                    }

                    Text {
                        text: "8.6 IMDb";
                        color: Theme.secondary-foreground;
                        font-size: 0.75 * root.unit;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Text {
            text: "Dune: Part Two (2024)";
            color: Theme.primary-foreground;
            font-size: 1.8 * root.unit;
            font-weight: 700;
        }

        // Technical badges row
        HorizontalLayout {
            spacing: 0.5 * root.unit;

            for badge in ["4K HDR", "Dolby Atmos", "AV1 10-bit", "2h 46m"] : Rectangle {
                height: 1.5 * root.unit;
                border-radius: 0.3 * root.unit;
                background: Theme.overlay-hover;
                border-width: 1px;
                border-color: Theme.card-border;

                HorizontalLayout {
                    padding-left: 0.5 * root.unit;
                    padding-right: 0.5 * root.unit;
                    Text {
                        text: badge;
                        color: Theme.primary-foreground;
                        font-size: 0.75 * root.unit;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Text {
            text: @tr("Paul Atreides unites with Chani and the Fremen while seeking revenge against the conspirators who destroyed his family.");
            color: Theme.text-secondary;
            font-size: 0.85 * root.unit;
            wrap: word-wrap;
        }

        Rectangle { height: 0.5 * root.unit; }

        // Action Buttons Row
        HorizontalLayout {
            spacing: 0.75 * root.unit;

            PillButton {
                unit: root.unit;
                height: 2.8 * root.unit;
                label: @tr("Play Stream");
                show-icon: true;
                icon-source: @image-url("../assets/images/icons/play.svg");
                primary: true;
            }

            PillButton {
                unit: root.unit;
                height: 2.8 * root.unit;
                label: @tr("Add to Library");
                show-icon: true;
                icon-source: @image-url("../assets/images/icons/add-to-library.svg");
                outlined: true;
            }
        }
    }
}

// ── Stremio Native Card 2: Streams & Torrent Health List Preview ──
component StremioStreamsCard inherits StudioPreviewCard {
    VerticalLayout {
        padding: 1.25 * root.unit;
        spacing: 0.8 * root.unit;

        HorizontalLayout {
            alignment: space-between;

            Text {
                text: @tr("Available Streams");
                color: Theme.primary-foreground;
                font-size: 1.1 * root.unit;
                font-weight: 700;
            }

            Text {
                text: "Torrentio v4.2";
                color: Theme.text-muted;
                font-size: 0.8 * root.unit;
            }
