                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 1.6 * root.unit;
                    border-radius: 0.3 * root.unit;
                    background: Theme.primary-accent;

                    HorizontalLayout {
                        padding-left: 0.6 * root.unit;
                        padding-right: 0.6 * root.unit;
                        Text { text: "4K UHD"; color: Theme.primary-foreground; font-size: 0.75 * root.unit; font-weight: 700; vertical-alignment: center; }
