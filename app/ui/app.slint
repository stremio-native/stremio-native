export struct PluginAction {
    id: string,
    label: string,
    icon: string,
}

component GuideRow inherits Rectangle {
    in property <length> unit: Theme.root-font-size;
    in property <string> label;
    in property <string> keys;

    height: 3.35 * root.unit;
    background: transparent;

    HorizontalLayout {
        spacing: root.unit;

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: Theme.text-primary;
            font-size: root.unit;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            KeyCap {
                unit: root.unit;
                label: root.keys;
            }
        }
    }
}

component GuideSectionTitle inherits Text {
    in property <length> unit: Theme.root-font-size;
    height: 3 * root.unit;
    color: Theme.text-secondary;
    font-size: root.unit;
    font-weight: 700;
    vertical-alignment: center;
}

export { Theme, IconData, MediaCardItem, StreamLink, EpisodeItem, CastDevice, BoardSection, DiscoverRow, LibraryRow, AddonItem, CalendarRow, CalendarCell, CalendarMediaItem, SearchSuggestion, DownloadItem, HotkeyItem }

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("assets/images/app_icon.png");
    title: "Stremio";
    tooltip: "Stremio";

    in property <string> version: "";
    in property <int> update-state: 0;
    in property <string> update-version: "";
    in property <bool> update-can-install: false;
    in property <bool> update-installing: false;

    callback open-window();
    callback open-settings();
    callback open-logs();
    callback check-update();
    callback install-update();
    callback quit();

    clicked => { root.open-window(); }

    Menu {
        MenuItem {
            title: "Stremio";
            icon: @image-url("assets/images/app_icon.png");
            enabled: false;
        }
        MenuSeparator { }
        MenuItem {
            title: @tr("Open Stremio");
            activated => { root.open-window(); }
        }
        MenuItem {
            title: @tr("SETTINGS" => "Settings");
            activated => { root.open-settings(); }
        }
        MenuItem {
            title: @tr("Open Logs Folder");
            activated => { root.open-logs(); }
        }
        MenuSeparator { }
        MenuItem {
            title: root.update-installing
                ? @tr("Downloading update…")
                : (root.update-state == 1
                ? @tr("Checking for updates…")
                : (root.update-state == 2
                    ? @tr("Update available") + ": v" + root.update-version
                    : (root.update-state == 3
                        ? @tr("Stremio is up to date")
                        : (root.update-state == 4
                            ? @tr("Update check failed")
                            : @tr("Current version") + ": v" + root.update-version))));
            enabled: false;
        }
        MenuItem {
            title: @tr("Check for Updates");
            enabled: root.update-state != 1 && !root.update-installing;
            activated => { root.check-update(); }
        }
        MenuItem {
            title: root.update-can-install ? @tr("Install Update") : @tr("View Update");
            enabled: root.update-state == 2 && !root.update-installing;
            activated => { root.install-update(); }
        }
        MenuSeparator { }
        MenuItem {
            title: @tr("QUIT" => "Quit");
            activated => { root.quit(); }
        }
        MenuItem {
            title: @tr("SETTINGS_SHELL_VERSION" => "Shell Version") + ": " + root.version;
            enabled: false;
        }
    }
}

export component MainWindow inherits Window {
    title: "Stremio";
    icon: @image-url("assets/images/app_icon.png");
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 1000px;
    min-height: 600px;
    background: Theme.background;
    default-font-family: "Plus Jakarta Sans";
    forward-focus: app-shortcuts;
    property <length> ui-unit: root.width >= 2800px ? 18px :
        (root.width >= 2200px ? 16px : (root.width >= 1600px ? 15px : 14px));
    in-out property <bool> profile-menu-open: false;
    in-out property <bool> hotkey-editor-open: false;
    in-out property <[HotkeyItem]> hotkey-items: [];
    in-out property <string> hotkey-conflict: "";
    callback hotkey-rebind(string, string);
    callback hotkey-reset();
    in-out property <bool> shortcuts-modal-open: false;
    in-out property <bool> gamepad-modal-open: false;
    in-out property <bool> updater-banner-dismissed: false;
    in-out property <bool> event-modal-open: false;
    in-out property <string> event-modal-id: "";
    in-out property <string> event-modal-title: "";
    in-out property <string> event-modal-message: "";
    in-out property <image> event-modal-artwork;
    in-out property <string> event-modal-addon-name: "";
    in-out property <string> event-modal-addon-manifest-url: "";
    in-out property <string> event-modal-external-url: "";
    callback event-dismiss(string);
    callback event-action(string, string);

    // Disabled by default. `slint-viewer --load-data` can enable this harness
    // without replacing MainWindow, so every state uses the production shell,
    // routing bounds, overlays, and page components.
    in-out property <bool> debug-preview-enabled: false;
    in-out property <bool> debug-menu-open: false;
    in-out property <int> debug-preview-page: 0;
    in-out property <string> debug-preview-state: "loaded";
    in-out property <string> ui-style: "cinematic";
    in-out property <string> debug-missing-artwork-path: "";
    in-out property <bool> debug-show-missing-artwork: false;

    private property <[DebugPageOption]> debug-pages: [
        { label: @tr("Auth"), page: -1 },
        { label: @tr("Board"), page: 0 },
        { label: @tr("Discover" => "Discover"), page: 1 },
        { label: @tr("Library" => "Library"), page: 2 },
        { label: @tr("ADDONS" => "Addons"), page: 3 },
        { label: @tr("SETTINGS" => "Settings"), page: 4 },
        { label: @tr("Calendar"), page: 5 },
        { label: @tr("STREMIO_TV_NAV_SEARCH" => "Search"), page: 6 },
        { label: @tr("Details"), page: 7 },
        { label: @tr("SETTINGS_NAV_PLAYER" => "Player"), page: 8 },
        { label: @tr("DOWNLOADS_TITLE" => "Downloads"), page: 9 }
    ];
    private property <[DebugStateOption]> debug-auth-states: [
        { label: @tr("LOGIN_LABEL" => "Login"), value: "login" },
        { label: @tr("Register"), value: "register" },
        { label: @tr("Loading"), value: "auth-loading" },
        { label: @tr("Invalid credentials"), value: "auth-error" }
    ];
    private property <[DebugStateOption]> debug-board-states: [
        { label: @tr("Loaded"), value: "loaded" },
        { label: @tr("Loading"), value: "loading" },
        { label: @tr("Empty"), value: "empty" },
        { label: @tr("Continue watching only"), value: "continue-only" },
        { label: @tr("Catalogs only"), value: "catalogs-only" },
        { label: @tr("Profile menu"), value: "profile-menu" }
    ];
    private property <[DebugStateOption]> debug-discover-states: [
        { label: @tr("CATALOG" => "Catalog"), value: "catalog" },
        { label: @tr("Loading"), value: "loading" },
        { label: @tr("Empty"), value: "empty" },
        { label: @tr("Movie selected"), value: "movie-selected" },
        { label: @tr("Series selected"), value: "series-selected" },
        { label: @tr("Type dropdown"), value: "type-dropdown" },
        { label: @tr("Catalog dropdown"), value: "catalog-dropdown" },
        { label: @tr("Genre dropdown"), value: "genre-dropdown" }
    ];
    private property <[DebugStateOption]> debug-library-states: [
        { label: @tr("Loaded"), value: "loaded" },
        { label: @tr("Loading"), value: "loading" },
        { label: @tr("Empty"), value: "empty" },
        { label: @tr("Type dropdown"), value: "type-dropdown" },
        { label: @tr("Sort dropdown"), value: "sort-dropdown" }
    ];
    private property <[DebugStateOption]> debug-addons-states: [
        { label: @tr("Loaded"), value: "loaded" },
        { label: @tr("Loading"), value: "loading" },
        { label: @tr("Empty"), value: "empty" },
        { label: @tr("Addon details"), value: "addon-details" },
        { label: @tr("Details loading"), value: "addon-details-loading" },
        { label: @tr("Details error"), value: "addon-details-error" },
        { label: @tr("Filter dropdown"), value: "filter-dropdown" },
        { label: @tr("Type dropdown"), value: "type-dropdown" },
        { label: @tr("Add addon dialog"), value: "add-addon" }
    ];
    private property <[DebugStateOption]> debug-settings-states: [
        { label: @tr("SETTINGS_NAV_GENERAL" => "General & System"), value: "general" },
        { label: @tr("PROFILES_TITLE" => "Account & Profiles"), value: "profiles" },
        { label: @tr("INTEGRATIONS_TITLE" => "Integrations & Addons"), value: "integrations" },
        { label: @tr("INTERFACE" => "Appearance & Display"), value: "interface" },
        { label: @tr("SETTINGS_NAV_PLAYER" => "Playback & Streaming"), value: "player-settings" },
        { label: @tr("SETTINGS_NAV_STREAMING" => "Streaming"), value: "streaming" },
        { label: @tr("OPERATIONS_TITLE" => "Backup, Diagnostics & Tools"), value: "operations" },
        { label: @tr("SETTINGS_NAV_SHORTCUTS" => "Keyboard & Hotkeys"), value: "shortcuts" },
        { label: @tr("Diagnostics"), value: "diagnostics" },
        { label: @tr("Exporting"), value: "exporting" },
        { label: @tr("Onboarding Modal"), value: "onboarding-modal" },
        { label: @tr("Update Dialog"), value: "update-dialog" }
    ];
    private property <[DebugStateOption]> debug-calendar-states: [
        { label: @tr("Month loaded"), value: "loaded" },
        { label: @tr("Loading"), value: "loading" },
        { label: @tr("Signed out"), value: "signed-out" },
        { label: @tr("Empty month"), value: "empty" }
    ];
    private property <[DebugStateOption]> debug-search-states: [
        { label: @tr("Results"), value: "results" },
        { label: @tr("Loading"), value: "loading" },
        { label: @tr("No results"), value: "empty" },
        { label: @tr("No query"), value: "idle" }
    ];
    private property <[DebugStateOption]> debug-details-states: [
        { label: @tr("Loading title"), value: "details-loading" },
        { label: @tr("Movie streams"), value: "movie-streams" },
        { label: @tr("Movie no streams"), value: "movie-no-streams" },
        { label: @tr("Movie filter open"), value: "movie-filter" },
        { label: @tr("Series episodes"), value: "series-episodes" },
        { label: @tr("Season dropdown"), value: "series-season-menu" },
        { label: @tr("Selected episode streams"), value: "series-streams" },
        { label: @tr("Streams still loading"), value: "series-stream-loading" },
        { label: @tr("Episode no streams"), value: "series-no-streams" }
    ];
    private property <[DebugStateOption]> debug-player-states: [
        { label: @tr("Loading"), value: "player-loading" },
        { label: @tr("Buffering"), value: "buffering" },
        { label: @tr("Paused controls"), value: "paused" },
        { label: @tr("Playing controls"), value: "playing" },
        { label: @tr("Skip intro"), value: "skip-intro" },
        { label: @tr("Subtitle menu"), value: "subtitles" },
        { label: @tr("Audio menu"), value: "audio" },
        { label: @tr("Speed menu"), value: "speed" },
        { label: @tr("Playback info"), value: "stats" },
        { label: @tr("More options"), value: "options" },
        { label: @tr("Context menu"), value: "context-menu" },
        { label: @tr("Episode drawer"), value: "episodes" },
        { label: @tr("Playback error"), value: "player-error" },
        { label: @tr("Controls hidden"), value: "controls-hidden" }
    ];
    private property <[DebugStateOption]> debug-state-options:
        root.debug-preview-page == -1 ? root.debug-auth-states :
        (root.debug-preview-page == 0 ? root.debug-board-states :
        (root.debug-preview-page == 1 ? root.debug-discover-states :
        (root.debug-preview-page == 2 ? root.debug-library-states :
        (root.debug-preview-page == 3 ? root.debug-addons-states :
        (root.debug-preview-page == 4 ? root.debug-settings-states :
        (root.debug-preview-page == 5 ? root.debug-calendar-states :
        (root.debug-preview-page == 6 ? root.debug-search-states :
        (root.debug-preview-page == 7 ? root.debug-details-states : root.debug-player-states))))))));

    private property <int> effective-active-tab: root.debug-preview-enabled
        ? (root.debug-preview-page >= 0 && root.debug-preview-page <= 6
            ? root.debug-preview-page : (root.debug-preview-page == 9 ? 7 : 0))
        : root.active-tab;
    private property <bool> effective-show-details: root.debug-preview-enabled
        ? root.debug-preview-page == 7
        : root.show-details;
    private property <bool> effective-show-player: root.debug-preview-enabled
        ? root.debug-preview-page == 8
        : root.show-player;
    private property <bool> show-auth-page: root.debug-preview-enabled
        ? root.debug-preview-page == -1
        : root.username == "";
    private property <bool> show-main-shell: root.debug-preview-enabled
        ? (root.debug-preview-page >= 0 && root.debug-preview-page <= 6) || root.debug-preview-page == 9
        : root.username != "";

    // Bindings / API exposed to Rust code
    in-out property <int> active-tab: 0; // 0: Board, 1: Discover, 2: Library, 3: Addons, 4: Settings, 5: Calendar, 6: Search, 7: Downloads
    in-out property <string> username: "";
    in-out property <string> avatar-letter: "U";
