    public function close-player-menus() {
        root.player-show-subtitles-menu = false;
        root.player-show-audio-menu = false;
        root.player-show-speed-menu = false;
        root.player-show-stats-menu = false;
        root.player-show-upscaler-menu = false;
        root.player-show-options-menu = false;
        root.player-show-tools-menu = false;
        root.player-show-streams-menu = false;
        root.player-show-cast-menu = false;
        root.player-show-playlist-drawer = false;
        root.player-show-context-menu = false;
    }

    public function focus-app-shortcuts() {
        app-shortcuts.focus();
    }

    function toggle-player-menu(menu: string) {
        let was-open = (menu == "subtitles" && root.player-show-subtitles-menu)
            || (menu == "audio" && root.player-show-audio-menu)
            || (menu == "speed" && root.player-show-speed-menu)
            || (menu == "stats" && root.player-show-stats-menu)
            || (menu == "info" && root.player-show-playlist-drawer);
        root.close-player-menus();
        if (!was-open) {
            root.player-show-subtitles-menu = menu == "subtitles";
            root.player-show-audio-menu = menu == "audio";
            root.player-show-speed-menu = menu == "speed";
            root.player-show-stats-menu = menu == "stats";
            root.player-show-playlist-drawer = menu == "info";
        }
        root.player-controls-visible = true;
        root.player-activity();
    }

    function adjust-player-subtitle-size(direction: int) {
        let current = root.player-subtitle-size-percent;
        let next = direction > 0
            ? (current < 75 ? 75 : (current < 100 ? 100 : (current < 125 ? 125
                : (current < 150 ? 150 : (current < 175 ? 175 : (current < 200 ? 200 : 250))))))
            : (current > 200 ? 200 : (current > 175 ? 175 : (current > 150 ? 150
                : (current > 125 ? 125 : (current > 100 ? 100 : 75)))));
        root.player-subtitle-size-percent = next;
        root.player-change-subtitle-size(next);
        root.player-activity();
    }

    changed effective-show-player => {
        if (root.effective-show-player) {
            root.close-player-menus();
            app-shortcuts.focus();
        } else {
            root.close-player-menus();
        }
    }

    // Closing an overlay menu destroys the focus scope that was holding the
    // keyboard, leaving nothing focused. Park focus back on the global shortcut
    // scope so arrow/Tab/Enter navigation has somewhere to land. Player hotkeys
    // themselves are dispatched natively in `shortcuts.rs` before Slint sees the
    // event, so they do not depend on this.
    changed player-menu-open => {
        if (!root.player-menu-open && root.effective-show-player) {
            app-shortcuts.focus();
        }
    }

    app-shortcuts := FocusScope {
        KeyBinding { keys: @keys("1"); enabled: !root.effective-show-player; activated => { root.tab-changed(0); } }
        KeyBinding { keys: @keys("2"); enabled: !root.effective-show-player; activated => { root.tab-changed(1); } }
        KeyBinding {
            keys: @keys("3");
            enabled: !root.effective-show-player;
            activated => {
                root.library-continue-watching-mode = false;
                root.tab-changed(2);
            }
        }
        KeyBinding { keys: @keys("4"); enabled: !root.effective-show-player; activated => { root.tab-changed(5); } }
        KeyBinding { keys: @keys("5"); enabled: !root.effective-show-player; activated => { root.tab-changed(3); } }
        KeyBinding { keys: @keys("6"); enabled: !root.effective-show-player; activated => { root.tab-changed(4); } }
        KeyBinding { keys: @keys("7"); enabled: !root.effective-show-player; activated => { root.tab-changed(7); } }
        KeyBinding { keys: @keys("0"); enabled: !root.effective-show-player; activated => { root.tab-changed(6); } }
        KeyBinding { keys: @keys(Backspace); enabled: !root.effective-show-player; activated => { root.navigation-back(); } }
        KeyBinding { keys: @keys(Control + Backspace); enabled: !root.effective-show-player; activated => { root.navigation-forward(); } }
        KeyBinding {
            keys: @keys(Control + "/");
            enabled: !root.effective-show-player;
            activated => {
                root.shortcuts-modal-open = !root.shortcuts-modal-open;
            }
        }
        KeyBinding {
            keys: @keys(Control + G);
            enabled: !root.effective-show-player;
            activated => { root.gamepad-modal-open = !root.gamepad-modal-open; }
        }
        KeyBinding {
            keys: @keys(Escape);
            enabled: !root.effective-show-player
                && (root.shortcuts-modal-open || root.gamepad-modal-open);
            activated => {
                root.shortcuts-modal-open = false;
                root.gamepad-modal-open = false;
                app-shortcuts.focus();
            }
        }
    }

    // Visual layout routing
    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;

        app-shell := Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            visible: !root.effective-show-player;
            background: root.show-auth-page ? Theme.background : Theme.main-gradient;

            Rectangle {
                width: 100%;
                height: 100%;

        if (root.show-auth-page) : AuthPage {
            width: 100%;
            height: 100%;
            unit: root.ui-unit;
            error-message: root.debug-preview-enabled && root.debug-preview-page == -1
                ? (root.debug-preview-state == "auth-error" ? "The email or password is incorrect." : "")
                : error-message;
            loading: root.debug-preview-enabled && root.debug-preview-page == -1
                ? root.debug-preview-state == "auth-loading"
                : loading;
            register-mode: root.debug-preview-enabled && root.debug-preview-page == -1
                && root.debug-preview-state == "register";
            mail-icon: mail-icon;
            lock-icon: lock-icon;
            facebook-icon: facebook-icon;
            apple-icon: apple-icon;
            submit-login(email, pass) => { submit-login(email, pass); }
            submit-register(email, pass, tos, priv, mkt) => { submit-register(email, pass, tos, priv, mkt); }
            facebook-login => { facebook-login(); }
            apple-login => { apple-login(); }
            cancel-auth => { cancel-auth(); }
            request-password-reset(email) => { request-password-reset(email); }
            guest-login => { guest-login(); }
        }

        if (root.show-main-shell) : VerticalLayout {
            width: 100%;
            height: 100%;
            visible: !root.effective-show-details;
            spacing: 0;
            padding: 0;

            // Official horizontal navigation bar.
            Rectangle {
                height: 5.5 * root.ui-unit;
                visible: !root.effective-show-details;
                background: transparent;
                z: 100;

                HorizontalLayout {
                    padding-right: root.ui-unit;
                    alignment: space-between;

                    // Left Block: Logo symbol
                    Rectangle {
                        width: Theme.vertical-nav-bar-size;
                        height: Theme.horizontal-nav-bar-size;
                        
                        Image {
                            source: @image-url("assets/images/stremio-logo.svg");
                            width: 2.5 * root.ui-unit;
                            height: 2.5 * root.ui-unit;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            opacity: 0.9;
                        }
                    }

                    // Search bar in top navbar
                    HorizontalLayout {
                        alignment: center;
                        padding-top: 1 * root.ui-unit;
                        padding-bottom: 1 * root.ui-unit;
                        padding-left: 2 * root.ui-unit;
                        padding-right: 2 * root.ui-unit;
                        
                        search-input := SearchBox {
                            width: 28 * root.ui-unit;
                            height: 3.5 * root.ui-unit;
                            unit: root.ui-unit;
                            text <=> root.search-query;
                            suggestions: root.search-suggestions;
                            edited(value) => {
                                global-search-edited(value);
                                if (root.effective-active-tab == 1
                                    || root.effective-active-tab == 8
                                    || root.effective-active-tab == 9
                                    || root.effective-active-tab == 10
                                    || root.effective-active-tab == 11) {
                                    discover-search-changed(value);
                                } else if (root.effective-active-tab == 2) {
                                    library-search-changed(value);
                                }
                            }
                            accepted(value) => {
                                if (value != "") {
                                    global-search-submitted(value);
                                }
                            }
                            cleared => { global-search-edited(""); }
                            suggestion-selected(_id, _media-type, title) => {
                                root.search-query = title;
                                root.global-search-suggestion-selected(title);
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 0.5 * root.ui-unit;
                        alignment: center;
                        padding-top: 0.5 * root.ui-unit;

                        Rectangle {
                            width: 3.5 * root.ui-unit;
                            height: 3.5 * root.ui-unit;
                            border-radius: 0.75 * root.ui-unit;
                            background: top-fullscreen.has-hover ? Theme.overlay : transparent;
                            top-fullscreen := TouchArea {
                                clicked => { root.player-toggle-fullscreen(); }
                            }
                             Image {
                                source: @image-url("assets/images/icons/maximize.svg");
                                width: 2 * root.ui-unit;
                                height: 2 * root.ui-unit;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                opacity: 0.6;
                                image-fit: contain;
                            }
                        }

                        Rectangle {
                            width: 5.5 * root.ui-unit;
                            height: 3.5 * root.ui-unit;
                            border-radius: 0.75 * root.ui-unit;
                            background: profile-area.has-hover ? Theme.overlay : transparent;

                            profile-area := TouchArea {
                                clicked => { root.profile-menu-open = !root.profile-menu-open; }
                            }

                            Rectangle {
                                x: 0.55 * root.ui-unit;
                                y: 0.55 * root.ui-unit;
                                width: 2.4 * root.ui-unit;
                                height: 2.4 * root.ui-unit;
                                background: Theme.accent;
                                border-radius: self.width / 2;
                                border-width: 0.15 * root.ui-unit;
                                border-color: Theme.accent;
                                clip: true;
                            
                                if (username == "" || username == "Guest") : Image {
                                    source: anonymous-icon;
                                    width: parent.width;
                                    height: parent.height;
                                    image-fit: cover;
                                }
                            
                                if (username != "" && username != "Guest" && has-avatar-image) : Image {
                                    source: avatar-image;
                                    width: parent.width;
                                    height: parent.height;
                                    image-fit: cover;
                                }
                            
                                if (username != "" && username != "Guest" && !has-avatar-image) : Image {
                                    source: default-avatar-icon;
                                    width: parent.width;
                                    height: parent.height;
                                    image-fit: cover;
                                }
                            }

                            Image {
                                x: parent.width - self.width - 0.55 * root.ui-unit;
                                y: (parent.height - self.height) / 2;
                                width: root.ui-unit;
                                height: root.ui-unit;
                                source: @image-url("assets/images/icons/caret-down.svg");
                                colorize: Theme.text-primary;
                                opacity: 0.6;
                                image-fit: contain;
                            }
                        }
                    }
                }

                if (root.profile-menu-open) : Rectangle {
                    x: 0px;
                    y: 0px;
                    width: root.width;
                    height: root.height;
                    background: transparent;
                    z: 190;

                    TouchArea {
                        clicked => { root.profile-menu-open = false; }
                    }
                }

                if (root.profile-menu-open) : Rectangle {
                    x: parent.width - 23 * root.ui-unit;
                    y: 6.5 * root.ui-unit;
                    width: 22 * root.ui-unit;
                    height: layout.preferred-height;
                    border-radius: 0.75 * root.ui-unit;
                    background: Theme.modal-background;
                    clip: true;
                    z: 200;

                    layout := VerticalLayout {
                        spacing: 0px;

                        HorizontalLayout {
                            height: 7 * root.ui-unit;
                            padding-left: root.ui-unit;
                            padding-right: root.ui-unit;
                            spacing: root.ui-unit;
                            alignment: start;

                            Rectangle {
                                width: 4 * root.ui-unit;
                                height: 4 * root.ui-unit;
                                border-radius: self.width / 2;
                                background: Theme.text-primary;
                                clip: true;
                                y: (parent.height - self.height) / 2;

                                if (username == "" || username == "Guest") : Image {
                                    source: anonymous-icon;
                                    width: parent.width;
                                    height: parent.height;
                                    image-fit: cover;
                                }
                                if (username != "" && username != "Guest" && has-avatar-image) : Image {
                                    source: avatar-image;
                                    width: parent.width;
                                    height: parent.height;
                                    image-fit: cover;
                                }
                                if (username != "" && username != "Guest" && !has-avatar-image) : Image {
                                    source: default-avatar-icon;
                                    width: parent.width;
                                    height: parent.height;
                                    image-fit: cover;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 0.5 * root.ui-unit;
                                Text {
                                    text: username == "" || username == "Guest" ? @tr("ANONYMOUS_USER" => "Anonymous user") : username;
                                    color: Theme.text-primary;
                                    font-size: root.ui-unit;
                                    overflow: elide;
                                }
                                Text {
                                    text: username == "" || username == "Guest" ? @tr("Log in / Sign up") : @tr("LOG_OUT" => "Log out");
                                    color: Theme.accent;
                                    font-size: 0.9 * root.ui-unit;
                                    font-weight: 600;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.profile-menu-open = false;
                                            if (username == "" || username == "Guest") {
                                                username = "";
                                            } else {
                                                root.logout();
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.overlay; }

                        MenuButton {
                            unit: root.ui-unit;
                            label: root.is-fullscreen ? @tr("EXIT_FULLSCREEN" => "Exit fullscreen mode") : @tr("ENTER_FULLSCREEN" => "Enter fullscreen mode");
                            show-icon: true;
                            icon-source: root.is-fullscreen ? @image-url("assets/images/icons/minimize.svg") : @image-url("assets/images/icons/maximize.svg");
                            clicked => {
                                root.profile-menu-open = false;
                                root.toggle-fullscreen();
                            }
                        }

                        Rectangle { height: 1px; background: Theme.overlay; }

                        MenuButton {
                            unit: root.ui-unit;
                            label: @tr("SETTINGS" => "Settings");
                            show-icon: true;
                            icon-source: @image-url("assets/images/icons/settings.svg");
                            clicked => {
                                root.profile-menu-open = false;
                                root.tab-changed(4);
                            }
                        }
                        MenuButton {
                            unit: root.ui-unit;
                            label: @tr("ADDONS" => "Addons");
                            show-icon: true;
                            icon-source: @image-url("assets/images/icons/addons.svg");
                            clicked => {
                                root.profile-menu-open = false;
                                root.tab-changed(3);
                            }
                        }
                        MenuButton {
                            unit: root.ui-unit;
                            label: @tr("PLAY_URL_MAGNET_LINK" => "Play URL/Magnet link");
                            show-icon: true;
                            icon-source: @image-url("assets/images/icons/magnet-link.svg");
                            clicked => {
                                root.profile-menu-open = false;
                                root.play-url-magnet-from-clipboard();
                            }
                        }
                        MenuButton {
                            unit: root.ui-unit;
                            label: @tr("HELP_FEEDBACK" => "Help & Feedback");
                            show-icon: true;
                            icon-source: @image-url("assets/images/icons/help.svg");
                            clicked => {
                                root.profile-menu-open = false;
                                root.open-external-url("https://stremio.zendesk.com/");
                            }
                        }

                        Rectangle { height: 1px; background: Theme.overlay; }

                        MenuButton {
                            unit: root.ui-unit;
                            label: @tr("TERMS_OF_SERVICE" => "Terms of Service");
                            show-icon: false;
                            clicked => {
                                root.profile-menu-open = false;
                                root.open-external-url("https://www.stremio.com/tos");
                            }
                        }
                        MenuButton {
                            unit: root.ui-unit;
                            label: @tr("PRIVACY_POLICY" => "Privacy Policy");
                            show-icon: false;
                            clicked => {
                                root.profile-menu-open = false;
                                root.open-external-url("https://www.stremio.com/privacy");
                            }
                        }
                        if (username != "" && username != "Guest") : MenuButton {
                            unit: root.ui-unit;
                            label: @tr("USER_PANEL" => "User Panel");
                            show-icon: false;
                            clicked => {
                                root.profile-menu-open = false;
                                root.open-external-url("https://www.stremio.com/acc-settings");
                            }
                        }
                    }
                }
            }

            if (root.settings-update-state == 2 && !root.updater-banner-dismissed) : Rectangle {
                height: 4 * root.ui-unit;
                background: Theme.accent;
                z: 90;

                HorizontalLayout {
                    padding-left: root.ui-unit;
                    padding-right: root.ui-unit;
                    spacing: root.ui-unit;
                    alignment: center;

                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text {
                        text: @tr("UPDATER_TITLE" => "A new version of Stremio is available");
                        color: Theme.background;
                        font-size: root.ui-unit;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    PillButton {
                        height: 2.5 * root.ui-unit;
                        unit: root.ui-unit;
                        label: @tr("UPDATER_INSTALL_BUTTON" => "Install");
                        surface-color: Theme.text-primary;
                        accent-color: Theme.background;
                        clicked => { root.update-install(); }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    IconAction {
                        width: 3 * root.ui-unit;
                        height: 3 * root.ui-unit;
                        unit: root.ui-unit;
                        icon-source: @image-url("assets/images/icons/close.svg");
                        accessible-name: @tr("BUTTON_CLOSE" => "Close");
                        clicked => { root.updater-banner-dismissed = true; }
                    }
                }
            }

            // Lower Content Area (Sidebar on left, main content page on right)
            HorizontalLayout {
                spacing: 0;
                padding: 0;
                vertical-stretch: 1;

                Sidebar {
                    unit: root.ui-unit;
                    visible: !root.effective-show-details
                        && (root.home-layout-preset == "Side Rail" || root.home-layout-preset == "Classic Home");
                    active-tab: root.effective-active-tab;
                    server-status: server-status;
                    username: username;
                    avatar-letter: avatar-letter;
                    
                    board-icon: board-icon;
                    discover-icon: discover-icon;
                    library-icon: library-icon;
                    calendar-icon: calendar-icon;
                    addons-icon: addons-icon;
                    settings-icon: settings-icon;
                    logout-icon: logout-icon;

                    change-tab(tab) => {
                        if (tab == 4) {
                            root.settings-active-category = 0;
                        } else if (tab == 2) {
                            root.library-continue-watching-mode = false;
                        }
                        root.tab-changed(tab);
                    }
                    logout => { logout(); }
                }

                // Inner content area
                Rectangle {
                    min-width: 0px;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    background: transparent;
                    clip: true;
                    
                    if (root.effective-active-tab == 0) : BoardPage {
                        width: parent.width;
                        height: parent.height;
                        unit: root.ui-unit;
                        continue-watching: root.debug-preview-enabled && root.debug-preview-page == 0
                            && (root.debug-preview-state == "empty"
                                || root.debug-preview-state == "loading"
                                || root.debug-preview-state == "catalogs-only")
                            ? [] : board-continue-watching;
                        sections: root.debug-preview-enabled && root.debug-preview-page == 0
                            && (root.debug-preview-state == "empty"
                                || root.debug-preview-state == "loading"
                                || root.debug-preview-state == "continue-only")
                            ? [] : board-sections;
                        loading: root.debug-preview-enabled && root.debug-preview-page == 0
                            ? root.debug-preview-state == "loading"
                            : loading;
                        show-server-warning: root.board-show-server-warning;
                        item-selected(id, media-type, video-id) => {
                            board-item-selected(id, media-type, video-id);
                        }
                        play-clicked(id) => {
                            board-play-clicked(id);
                        }
                        remove-continue-watching(id) => { remove-continue-watching(id); }
                        see-all-continue-watching() => {
                            root.library-continue-watching-mode = true;
                            board-see-all-continue-watching();
                        }
                        see-all-clicked(index) => { board-see-all-clicked(index); }
                        catalog-visible(index) => { board-catalog-visible(index); }
                        dismiss-server-warning => { board-dismiss-server-warning(); }
                        reload-server => { board-reload-server(); }
                        open-server-settings => { board-open-server-settings(); }
                        poster-requested(url) => { request-poster(url); }
                    }

                    if (root.effective-active-tab == 1
                        || root.effective-active-tab == 8
                        || root.effective-active-tab == 9
                        || root.effective-active-tab == 10
                        || root.effective-active-tab == 11) : DiscoverPage {
                        width: parent.width;
                        height: parent.height;
                        unit: root.ui-unit;
                        rows: root.debug-preview-enabled && root.debug-preview-page == 1
                            && (root.debug-preview-state == "empty" || root.debug-preview-state == "loading")
                            ? [] : discover-rows;
                        column-count: discover-column-count;
                        has-next-page: discover-has-next-page;
                        loading: root.debug-preview-enabled && root.debug-preview-page == 1
                            ? root.debug-preview-state == "loading"
                            : loading;

                        available-types: discover-types;
                        active-type: discover-active-type;
                        available-catalogs: discover-catalogs;
                        active-catalog: discover-active-catalog;
                        available-genres: discover-genres;
                        active-genre: discover-active-genre;
                        available-extra-options: discover-extra-options;
                        selected-addon-installed: discover-selected-addon-installed;
                        selected-addon-name: discover-selected-addon-name;

                        has-preview: root.debug-preview-enabled && root.debug-preview-page == 1
                            ? (root.debug-preview-state == "movie-selected"
                                || root.debug-preview-state == "series-selected")
                            : discover-has-preview;
                        preview-title: root.debug-preview-enabled && root.debug-preview-page == 1
                            && root.debug-preview-state == "movie-selected"
                            ? "Dune: Part Two" : discover-preview-title;
                        preview-description: root.debug-preview-enabled && root.debug-preview-page == 1
                            && root.debug-preview-state == "movie-selected"
                            ? "Paul Atreides unites with Chani and the Fremen while seeking revenge against the conspirators who destroyed his family."
                            : discover-preview-description;
                        preview-rating: root.debug-preview-enabled && root.debug-preview-page == 1
                            && root.debug-preview-state == "movie-selected" ? "8.5" : discover-preview-rating;
                        preview-year: root.debug-preview-enabled && root.debug-preview-page == 1
                            && root.debug-preview-state == "movie-selected" ? "2024" : discover-preview-year;
                        preview-runtime: root.debug-preview-enabled && root.debug-preview-page == 1
                            && root.debug-preview-state == "movie-selected" ? "166 min" : discover-preview-runtime;
                        preview-genres: root.debug-preview-enabled && root.debug-preview-page == 1
                            && root.debug-preview-state == "movie-selected"
                            ? ["Science Fiction", "Adventure", "Drama"] : discover-preview-genres;
                        preview-cast: root.debug-preview-enabled && root.debug-preview-page == 1
                            && root.debug-preview-state == "movie-selected"
                            ? ["Timothée Chalamet", "Zendaya", "Rebecca Ferguson"] : discover-preview-cast;
                        preview-directors: root.debug-preview-enabled && root.debug-preview-page == 1
                            && root.debug-preview-state == "movie-selected"
                            ? ["Denis Villeneuve"] : discover-preview-directors;
                        preview-is-in-library: discover-preview-is-in-library;
                        preview-is-watched: discover-preview-is-watched;
                        preview-has-trailer: discover-preview-has-trailer;
                        preview-trailer-selection-id: detail-trailer-selection-id;
                        preview-poster: discover-preview-poster;
                        type-open: root.debug-preview-enabled && root.debug-preview-page == 1
                            && root.debug-preview-state == "type-dropdown";
                        catalog-open: root.debug-preview-enabled && root.debug-preview-page == 1
                            && root.debug-preview-state == "catalog-dropdown";
                        genre-open: root.debug-preview-enabled && root.debug-preview-page == 1
                            && root.debug-preview-state == "genre-dropdown";

                        type-changed(t) => { discover-type-changed(t); }
                        catalog-changed(c) => { discover-catalog-changed(c); }
                        genre-changed(g) => { discover-genre-changed(g); }
                        item-selected(id, media-type, video-id) => {
                            discover-item-selected(id, media-type, video-id);
                        }
                        item-activated(id, media-type, video-id) => {
                            discover-item-activated(id, media-type, video-id);
                        }
                        load-next-page => { discover-load-next-page(); }
                        extra-changed(name, value) => { discover-extra-changed(name, value); }
                        install-selected-addon => { discover-install-selected-addon(); }
                        metadata-filter-selected(value) => { discover-metadata-filter-selected(value); }
                        poster-requested(url) => { request-poster(url); }
                        play-preview => { play-preview(); }
                        toggle-library-preview => { toggle-library-preview(); }
                        toggle-watched-preview => { details-toggle-watched(); }
                        play-trailer-preview(selection-id) => { play-stream(selection-id); }
                        scroll-y <=> discover-scroll-y;
                    }

                    if (root.effective-active-tab == 2) : LibraryPage {
                        width: parent.width;
                        height: parent.height;
                        unit: root.ui-unit;
                        rows: root.debug-preview-enabled && root.debug-preview-page == 2
                            && (root.debug-preview-state == "empty" || root.debug-preview-state == "loading")
                            ? [] : library-rows;
                        local-rows: local-library-rows;
                        local-root-path <=> local-library-root-path;
                        local-scan-status: local-library-scan-status;
                        column-count: library-column-count;
                        has-next-page: library-has-next-page;
                        loading: root.debug-preview-enabled && root.debug-preview-page == 2
                            ? root.debug-preview-state == "loading"
                            : loading;
                        active-type: library-active-type;
                        active-sort: library-active-sort;
                        authenticated: library-authenticated;
                        continue-watching-mode: root.library-continue-watching-mode;
                        type-open: root.debug-preview-enabled && root.debug-preview-page == 2
                            && root.debug-preview-state == "type-dropdown";
                        sort-open: root.debug-preview-enabled && root.debug-preview-page == 2
                            && root.debug-preview-state == "sort-dropdown";

                        type-changed(t) => { library-type-changed(t); }
                        sort-changed(s) => { library-sort-changed(s); }
                        item-selected(id, media-type, video-id) => {
                            library-item-selected(id, media-type, video-id);
                        }
                        load-next-page => { library-load-next-page(); }
                        request-login => { root.username = ""; }
                        remove-item(id) => { library-remove-item(id); }
                        watched-changed(id, watched) => { library-watched-changed(id, watched); }
                        play-item(id) => { library-play-item(id); }
                        dismiss-item(id) => { library-dismiss-item(id); }
                        local-add-root(path) => { library-local-add-root(path); }
                        local-rescan => { library-local-rescan(); }
                        local-play(id) => { library-local-play(id); }
                        poster-requested(url) => { request-poster(url); }
                        scroll-y <=> library-scroll-y;
                    }

                    if (root.effective-active-tab == 3) : AddonsPage {
                        width: parent.width;
                        height: parent.height;
                        unit: root.ui-unit;
                        addons: root.debug-preview-enabled && root.debug-preview-page == 3
                            && (root.debug-preview-state == "empty" || root.debug-preview-state == "loading")
                            ? [] : addons-list;
                        community-addons: addons-community-list;
                        community-available: addons-community-available;
                        community-adult-unlocked <=> addons-community-adult-unlocked;
                        community-owner-pin <=> addons-community-owner-pin;
                        has-next-page: addons-has-next-page;
                        scroll-y <=> addons-scroll-y;
                        search-query: addons-search-query;
                        loading: root.debug-preview-enabled && root.debug-preview-page == 3
                            ? root.debug-preview-state == "loading"
                            : loading;
                        details-open: root.debug-preview-enabled && root.debug-preview-page == 3
                            ? (root.debug-preview-state == "addon-details"
                                || root.debug-preview-state == "addon-details-loading"
                                || root.debug-preview-state == "addon-details-error")
                            : addon-details-open;
                        details-addon: addon-details-addon;
                        details-loading: root.debug-preview-enabled && root.debug-preview-page == 3
                            ? root.debug-preview-state == "addon-details-loading"
                            : addon-details-loading;
                        details-error: root.debug-preview-enabled && root.debug-preview-page == 3
