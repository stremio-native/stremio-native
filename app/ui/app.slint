        if (root.effective-show-details) : DetailsPage {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            z: 500;
            unit: root.ui-unit;
            item-title: root.debug-preview-enabled && root.debug-preview-page == 7
                && (root.debug-preview-state == "movie-streams"
                    || root.debug-preview-state == "movie-no-streams"
                    || root.debug-preview-state == "movie-filter")
                ? "Dune: Part Two" : detail-title;
            description: root.debug-preview-enabled && root.debug-preview-page == 7
                && (root.debug-preview-state == "movie-streams"
                    || root.debug-preview-state == "movie-no-streams"
                    || root.debug-preview-state == "movie-filter")
                ? "Paul Atreides unites with Chani and the Fremen while seeking revenge against the conspirators who destroyed his family."
                : detail-description;
            poster: root.debug-preview-enabled && root.debug-preview-page == 7
                && (root.debug-preview-state == "movie-streams"
                    || root.debug-preview-state == "movie-no-streams"
                    || root.debug-preview-state == "movie-filter")
                ? @image-url("assets/images/background_1.svg") : detail-poster;
            background-image: root.debug-preview-enabled && root.debug-preview-page == 7
                && (root.debug-preview-state == "movie-streams"
                    || root.debug-preview-state == "movie-no-streams"
                    || root.debug-preview-state == "movie-filter")
                ? @image-url("assets/images/background_1.svg") : detail-background;
            release-year: root.debug-preview-enabled && root.debug-preview-page == 7
                && (root.debug-preview-state == "movie-streams"
                    || root.debug-preview-state == "movie-no-streams"
                    || root.debug-preview-state == "movie-filter") ? "2024" : detail-year;
            runtime: root.debug-preview-enabled && root.debug-preview-page == 7
                && (root.debug-preview-state == "movie-streams"
                    || root.debug-preview-state == "movie-no-streams"
                    || root.debug-preview-state == "movie-filter") ? "166 min" : detail-runtime;
            rating: root.debug-preview-enabled && root.debug-preview-page == 7
                && (root.debug-preview-state == "movie-streams"
                    || root.debug-preview-state == "movie-no-streams"
                    || root.debug-preview-state == "movie-filter") ? "8.5" : detail-rating;
            genres: root.debug-preview-enabled && root.debug-preview-page == 7
                && (root.debug-preview-state == "movie-streams"
                    || root.debug-preview-state == "movie-no-streams"
                    || root.debug-preview-state == "movie-filter")
                ? ["Science Fiction", "Adventure", "Drama"] : detail-genres;
            cast: root.debug-preview-enabled && root.debug-preview-page == 7
                && (root.debug-preview-state == "movie-streams"
                    || root.debug-preview-state == "movie-no-streams"
                    || root.debug-preview-state == "movie-filter")
                ? ["Timothée Chalamet", "Zendaya", "Rebecca Ferguson"] : detail-cast;
            directors: root.debug-preview-enabled && root.debug-preview-page == 7
                && (root.debug-preview-state == "movie-streams"
                    || root.debug-preview-state == "movie-no-streams"
                    || root.debug-preview-state == "movie-filter")
                ? ["Denis Villeneuve"] : detail-directors;
            enrichment-summary: detail-enrichment-summary;
            enrichment-attribution-url: detail-enrichment-attribution-url;
            open-attribution(url) => { root.open-external-url(url); }
            streams: root.debug-preview-enabled && root.debug-preview-page == 7
                && (root.debug-preview-state == "movie-no-streams"
                    || root.debug-preview-state == "series-no-streams"
                    || root.debug-preview-state == "details-loading")
                ? [] : stream-links;
            stream-providers: detail-stream-providers;
            ranking-mode <=> root.detail-ranking-mode;
            show-filtered <=> root.detail-show-filtered;
            stream-loading-count: root.debug-preview-enabled && root.debug-preview-page == 7
                ? (root.debug-preview-state == "series-stream-loading" ? 2 : 0)
                : detail-stream-loading-count;
            stream-filter-open: root.debug-preview-enabled && root.debug-preview-page == 7
                && root.debug-preview-state == "movie-filter";
            loading: root.debug-preview-enabled && root.debug-preview-page == 7
                ? root.debug-preview-state == "details-loading"
                : details-loading;
            username: root.username;
            avatar-image: root.avatar-image;
            has-avatar-image: root.has-avatar-image;
            default-avatar-icon: root.default-avatar-icon;
            anonymous-icon: root.anonymous-icon;

            is-in-library: detail-is-in-library;
            notifications-enabled: detail-notifications-enabled;
            is-watched: detail-is-watched;
            has-trailer: detail-has-trailer;
            trailer-selection-id: detail-trailer-selection-id;
            toggle-library => { details-toggle-library(); }
            toggle-watched => { details-toggle-watched(); }
            notifications-changed(enabled) => { details-notifications-changed(enabled); }
            play-trailer(selection-id) => { play-stream(selection-id); }

            is-series: root.debug-preview-enabled && root.debug-preview-page == 7
                ? (root.debug-preview-state == "series-episodes"
                    || root.debug-preview-state == "series-season-menu"
                    || root.debug-preview-state == "series-streams"
                    || root.debug-preview-state == "series-stream-loading"
                    || root.debug-preview-state == "series-no-streams")
                : detail-is-series;
            available-seasons: detail-seasons;
            active-season <=> root.detail-active-season;
            season-menu-open: root.debug-preview-enabled && root.debug-preview-page == 7
                && root.debug-preview-state == "series-season-menu";
            episode-names: detail-episode-names;
            active-episode-idx <=> root.detail-active-episode-idx;
            episodes: detail-episodes;
            in-stream-view: root.debug-preview-enabled && root.debug-preview-page == 7
                ? (root.debug-preview-state == "series-streams"
                    || root.debug-preview-state == "series-stream-loading"
                    || root.debug-preview-state == "series-no-streams")
                : detail-in-stream-view;
            episode-search-query: detail-episode-search-query;
            share-url: detail-share-url;

            icon-play: root.icon-play;
            icon-link: root.icon-link;
            icon-magnet: root.icon-magnet;
            icon-download: root.icon-download;
            icon-eye: root.icon-eye;
            icon-eye-off: root.icon-eye-off;
            icon-clapperboard: root.icon-clapperboard;

            season-changed(s) => { details-season-changed(s); }
            season-step(direction) => { details-season-step(direction); }
            episode-changed(idx, video-id) => {
                if (root.debug-preview-enabled && root.debug-preview-page == 7) {
                    root.detail-active-episode-idx = idx;
                    root.debug-preview-state = "series-streams";
                } else {
                    details-episode-changed(idx, video-id);
                }
            }
            toggle-episode-watched(id) => { details-toggle-episode-watched(id); }
            episode-search-changed(q) => {
                detail-episode-search-query = q;
                details-episode-search-changed(q);
            }
            copy-stream-link(id) => { details-copy-stream-link(id); }
            copy-magnet-link(id) => { details-copy-magnet-link(id); }
            copy-download-link(id) => { details-copy-download-link(id); }
            toggle-season-watched(s) => { details-toggle-season-watched(s); }
            manual-episode-selected(season, episode) => {
                details-manual-episode-selected(season, episode);
            }
            open-addons => { root.tab-changed(3); }
            share-copy(url) => { details-share-copy(url); }
            share-social(platform, url) => { details-share-social(platform, url); }
            ranking-mode-changed(mode) => { details-ranking-mode-changed(mode); }
            show-filtered-changed(show) => { details-show-filtered-changed(show); }
            play-stream(selection-id) => { play-stream(selection-id); }
            toggle-fullscreen => { root.player-toggle-fullscreen(); }
            close => {
                if (root.debug-preview-enabled && root.debug-preview-page == 7
                    && (root.debug-preview-state == "series-streams"
                        || root.debug-preview-state == "series-stream-loading"
                        || root.debug-preview-state == "series-no-streams")) {
                    root.debug-preview-state = "series-episodes";
                } else if (detail-in-stream-view) {
                    detail-in-stream-view = false;
                } else {
                    root.navigation-back();
                }
            }
        }
        }
        }

        if (root.effective-show-player) : PlayerPage {
            width: 100%;
            height: 100%;
            z: 1000;
            
            item-title: player-title;
            stream-name: player-stream-name;
            poster-image: player-poster-image;
            video-frame: player-video-frame;
            has-video-frame: root.debug-preview-enabled && root.debug-preview-page == 8
                ? root.debug-preview-state != "player-loading"
                : player-has-video-frame;
            loading: root.debug-preview-enabled && root.debug-preview-page == 8
                ? root.debug-preview-state == "player-loading"
                : player-loading;
            buffering: root.debug-preview-enabled && root.debug-preview-page == 8
                ? root.debug-preview-state == "buffering"
                : player-buffering;
            buffering-percent: player-buffering-percent;
            paused: root.debug-preview-enabled && root.debug-preview-page == 8
                ? (root.debug-preview-state == "paused" || root.debug-preview-state == "player-error")
                : player-paused;
            volume: player-volume;
            muted: player-muted;
            progress: player-progress;
            duration-seconds: player-duration-seconds;
            elapsed-time-str: player-elapsed-time-str;
            total-time-str: player-total-time-str;
            subtitles-tracks: player-subtitles-tracks;
            subtitle-track-languages: player-subtitle-track-languages;
            subtitle-track-origins: player-subtitle-track-origins;
            subtitle-languages: player-subtitle-languages;
            subtitle-language-track-indices: player-subtitle-language-track-indices;
            audio-tracks: player-audio-tracks;
            audio-track-languages: player-audio-track-languages;
            audio-track-labels: player-audio-track-labels;
            active-subtitle-idx: player-active-subtitle-idx;
            active-secondary-subtitle-idx: player-active-secondary-subtitle-idx;
            active-audio-idx: player-active-audio-idx;
            subtitle-delay-seconds: player-subtitle-delay-seconds;
            subtitle-size-percent: player-subtitle-size-percent;
            subtitle-offset-percent: player-subtitle-offset-percent;
            secondary-subtitle-size-percent: player-secondary-subtitle-size-percent;
            secondary-subtitle-offset-percent: player-secondary-subtitle-offset-percent;
            audio-delay-seconds: player-audio-delay-seconds;
            is-series: root.debug-preview-enabled && root.debug-preview-page == 8
                ? true : player-is-series;
            available-seasons: player-seasons;
            active-season <=> root.player-active-season;
            episodes: player-episodes;
            active-video-id <=> root.player-active-video-id;
            active-episode-idx <=> root.player-active-episode-idx;
            has-next-episode: player-has-next-episode;
            next-episode-title: root.player-next-episode-title;
            series-name: root.player-series-name;
            next-series-name: root.player-next-series-name;
            series-runtime: root.player-series-runtime;
            series-release-year: root.player-series-release-year;
            series-description: root.player-series-description;
            series-logo: root.player-series-logo;
            active-season-watched: root.player-active-season-watched;
            next-episode-poster: root.player-next-episode-poster;
            next-popup-duration-seconds: root.settings-next-video-popup-duration.to-float();
            playback-speed: player-playback-speed;
            video-scale-mode: player-video-scale-mode;
            error-message: root.debug-preview-enabled && root.debug-preview-page == 8
                ? (root.debug-preview-state == "player-error"
                    ? "The stream stopped unexpectedly. Select another stream and try again."
                    : "")
                : player-error;
            status-message: player-status-message;
            last-capture-path: player-last-capture-path;
            ab-loop-a: player-ab-loop-a;
            ab-loop-b: player-ab-loop-b;
            sleep-timer-label: player-sleep-timer-label;
            hdr-mode: player-hdr-mode;
            hdr-content: player-hdr-content;
            hdr-passthrough-available: player-hdr-passthrough-available;
            pip-active: player-pip-active;
            video-format: player-video-format;
            audio-format: player-audio-format;
            file-format: player-file-format;
            hardware-decoder: player-hwdec;
            buffered-percent: player-buffered-percent;
            download-speed: player-download-speed;
            upload-speed: player-upload-speed;
            peer-count: player-peer-count;
            stream-progress: player-stream-progress;
            seek-step-seconds: player-seek-step-seconds;
            show-skip-button: root.debug-preview-enabled && root.debug-preview-page == 8
                ? root.debug-preview-state == "skip-intro"
                : player-show-skip-button;
            skip-button-label: player-skip-button-label;
            controls-visible <=> root.player-controls-visible;
            show-subtitles-menu <=> root.player-show-subtitles-menu;
            show-audio-menu <=> root.player-show-audio-menu;
            show-speed-menu <=> root.player-show-speed-menu;
            show-stats-menu <=> root.player-show-stats-menu;
            show-upscaler-menu <=> root.player-show-upscaler-menu;
            show-options-menu <=> root.player-show-options-menu;
            show-tools-menu <=> root.player-show-tools-menu;
            show-streams-menu <=> root.player-show-streams-menu;
            available-streams: root.stream-links;
            show-cast-menu <=> root.player-show-cast-menu;
            cast-devices: root.player-cast-devices;
            cast-devices-loading: root.player-cast-devices-loading;
            show-context-menu <=> root.player-show-context-menu;
            show-playlist-drawer <=> root.player-show-playlist-drawer;
            active-shader-preset <=> root.player-active-shader-preset;
            shader-preset-available: root.player-shader-preset-available;
            shader-status: root.player-shader-status;
            thumbnail-preview: root.player-thumbnail-preview;
            thumbnail-visible: root.player-thumbnail-visible;
            thumbnail-hover-x: root.player-thumbnail-hover-x;
            thumbnail-loading: root.player-thumbnail-loading;
            thumbnail-has-frame: root.player-thumbnail-has-frame;
            thumbnail-aspect-ratio: root.player-thumbnail-aspect-ratio;
            thumbnail-time-label: root.player-thumbnail-time-label;
            
            icon-play: icon-play;
            icon-pause: icon-pause;
            icon-next: icon-next;
            icon-volume-high: icon-volume-high;
            icon-volume-low: icon-volume-low;
            icon-volume-mute: icon-volume-mute;
            icon-fullscreen: icon-fullscreen;
            icon-subtitles: icon-subtitles;
            icon-audio: icon-audio;
            icon-speed: icon-speed;
            icon-stats: icon-stats;
            icon-options: icon-options;
            icon-menu: icon-menu;
            icon-back: icon-back;
            
            toggle-pause => { player-toggle-pause(); }
            seek(val) => { player-seek(val); }
            seek-relative(seconds) => { player-seek-relative(seconds); }
            seek-hover(val) => { player-seek-hover(val); }
            seek-leave => { player-seek-leave(); }
            change-volume(val) => { player-change-volume(val); }
            toggle-mute => { player-toggle-mute(); }
            change-subtitle(idx) => { player-change-subtitle(idx); }
            change-secondary-subtitle(idx) => { player-change-secondary-subtitle(idx); }
            change-audio(idx) => { player-change-audio(idx); }
            change-subtitle-delay(value) => { player-change-subtitle-delay(value); }
            change-subtitle-size(value) => { player-change-subtitle-size(value); }
            change-subtitle-offset(value) => { player-change-subtitle-offset(value); }
            change-secondary-subtitle-size(value) => { player-change-secondary-subtitle-size(value); }
            change-secondary-subtitle-offset(value) => { player-change-secondary-subtitle-offset(value); }
            change-audio-delay(value) => { player-change-audio-delay(value); }
            change-speed(val) => { player-change-speed(val); }
            change-video-scale(mode) => { player-change-video-scale(mode); }
            change-shader-preset(idx) => { player-change-shader-preset(idx); }
            set-ab-loop-point(action) => { player-set-ab-loop-point(action); }
            set-sleep-timer(value) => { player-set-sleep-timer(value); }
            capture-frame => { player-capture-frame(); }
            reveal-last-capture => { player-reveal-last-capture(); }
            cycle-hdr-mode => { player-cycle-hdr-mode(); }
            toggle-pip => { player-toggle-pip(); }
            retry-playback => { player-retry-playback(); }
            choose-another-stream => { player-choose-another-stream(); }
            return-to-details => { player-return-to-details(); }
            switch-stream(selection-id) => { root.play-stream(selection-id); }
            skip-segment => { player-skip-segment(); }
            copy-stream-link => { player-copy-stream-link(); }
            copy-magnet-link => { player-copy-magnet-link(); }
            download-subs => { player-download-subs(); }
            download-video => { player-download-video(); }
            open-external-player => { player-open-external-player(); }
            refresh-cast-devices => { player-refresh-cast-devices(); }
            cast-device-selected(id) => { player-cast-device(id); }
            play-episode(idx, video-id) => { player-play-episode(idx, video-id); }
            play-next-episode => { player-next-episode(); }
            season-changed(season) => { player-season-changed(season); }
            season-step(direction) => { player-season-step(direction); }
            mark-season-watched(season) => { player-mark-season-watched(season); }
            toggle-episode-watched(video-id) => { player-toggle-episode-watched(video-id); }
            play-saved-episode(video-id) => { player-play-saved-episode(video-id); }
            toggle-fullscreen => { player-toggle-fullscreen(); }
            close => { player-close(); }
            activity => {
                player-activity();
                // The overlay's sliders and menus pull keyboard focus when used
                // and live outside `app-shortcuts`, which leaves in-UI key
                // navigation stranded on a control the user has moved on from.
                // Reclaim focus on any interaction when no menu needs the
                // keyboard. The `has-focus` guard keeps this to one call per
                // theft, not one per mouse-move.
                if (root.effective-show-player && !root.player-menu-open
                    && !app-shortcuts.has-focus) {
                    app-shortcuts.focus();
                }
            }
        }

        if (root.hotkey-editor-open) : HotkeyEditor {
            width: parent.width;
            height: parent.height;
            z: 5000;
            unit: root.ui-unit;
            items: root.hotkey-items;
            conflict: root.hotkey-conflict;
            rebind(action, binding) => { root.hotkey-rebind(action, binding); }
            reset => { root.hotkey-reset(); }
            close => {
                root.hotkey-editor-open = false;
                root.hotkey-conflict = "";
            }
        }

        event-dialog := EventModal {
            width: 100%;
            height: 100%;
            z: 2050;
            unit: root.ui-unit;
            open: root.event-modal-open;
            event-id: root.event-modal-id;
            title: root.event-modal-title;
            message: root.event-modal-message;
            artwork: root.event-modal-artwork;
            addon-name: root.event-modal-addon-name;
            addon-manifest-url: root.event-modal-addon-manifest-url;
            external-url: root.event-modal-external-url;
            close-requested(id) => { root.event-dismiss(id); }
            action-requested(id, url) => { root.event-action(id, url); }
        }

        if (root.show-profile-picker) : ProfilePicker {
            width: 100%;
            height: 100%;
            z: 2600;
            profiles: root.local-profiles;
            selected-id <=> root.profile-picker-selected-id;
            error-message: root.profile-picker-error;
            selected(id, pin) => { root.profile-picker-selected(id, pin); }
        }

        if (root.show-profile-manager) : ProfileManager {
            width: 100%;
            height: 100%;
            z: 2700;
            profiles: root.local-profiles;
            active-id: root.profile-picker-selected-id;
            owner-pin <=> root.profile-manager-owner-pin;
            error-message: root.profile-manager-error;
            create(name, role, pin, owner-pin) => { root.profile-manager-create(name, role, pin, owner-pin); }
            delete(id, owner-pin) => { root.profile-manager-delete(id, owner-pin); }
            close => {
                root.show-profile-manager = false;
                root.profile-manager-owner-pin = "";
                root.profile-manager-error = "";
            }
        }

        if (root.show-integrations-manager) : IntegrationsManager {
            width: 100%;
            height: 100%;
            z: 2700;
            configured: root.configured-integrations;
            status: root.integrations-status;
            configure(provider, secret, endpoint, chat-id) => {
                root.integration-configure(provider, secret, endpoint, chat-id);
            }
            disconnect(provider) => { root.integration-disconnect(provider); }
            close => {
                root.show-integrations-manager = false;
                root.integrations-status = "";
            }
        }

        if (root.show-operations-manager) : OperationsManager {
            width: 100%;
            height: 100%;
            z: 2700;
            backup-path <=> root.operations-backup-path;
            diagnostic-path <=> root.operations-diagnostic-path;
            region <=> root.operations-region;
            bandwidth-mbps <=> root.operations-bandwidth-mbps;
            layout-preset <=> root.home-layout-preset;
            status: root.operations-status;
            restore-ready: root.operations-restore-ready;
            create-backup(path, secrets, passphrase) => { root.operations-create-backup(path, secrets, passphrase); }
            preview-restore(path, passphrase) => { root.operations-preview-restore(path, passphrase); }
            apply-restore(path, passphrase) => { root.operations-apply-restore(path, passphrase); }
            create-diagnostics(path) => { root.operations-create-diagnostics(path); }
            run-speed-test(endpoint) => { root.operations-run-speed-test(endpoint); }
            save-network(region, bandwidth) => { root.operations-save-network(region, bandwidth); }
            apply-layout(preset) => { root.operations-apply-layout(preset); }
            import-theme(path) => { root.operations-import-theme(path); }
            export-theme(path) => { root.operations-export-theme(path); }
            import-player-layout(path) => { root.operations-import-player-layout(path); }
            export-player-layout(path) => { root.operations-export-player-layout(path); }
            reset-customization => { root.operations-reset-customization(); }
            close => {
                root.show-operations-manager = false;
                root.operations-status = "";
                root.operations-restore-ready = false;
            }
        }

        shortcuts-dialog := ModalDialog {
            width: 100%;
            height: 100%;
            z: 2100;
            unit: root.ui-unit;
            open: root.shortcuts-modal-open;
            title: @tr("SETTINGS_NAV_SHORTCUTS" => "Shortcuts");
            dialog-width: 78 * root.ui-unit;
            dialog-height: 48 * root.ui-unit;
            close-requested => {
                root.shortcuts-modal-open = false;
                app-shortcuts.focus();
            }

            ScrollView {
                viewport-width: self.width;
                horizontal-scrollbar-policy: always-off;

                HorizontalLayout {
                    width: parent.width;
                    spacing: 4 * root.ui-unit;
                    alignment: start;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 0px;
                        GuideSectionTitle { unit: root.ui-unit; text: @tr("SETTINGS_NAV_GENERAL" => "General"); }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_NAVIGATE_MENUS" => "Navigate menus"); keys: "1 – 6"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_GO_TO_SEARCH" => "Go to Search"); keys: "0"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_NAVIGATE_HISTORY" => "Navigate history"); keys: "Backspace / Ctrl + Backspace"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_FULLSCREEN" => "Fullscreen"); keys: "F"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_SHORTCUTS" => "Show shortcuts"); keys: "Ctrl + /"; }
                        GuideRow { unit: root.ui-unit; label: @tr("GAMEPAD_ACTION_GUIDE" => "Gamepad guide"); keys: "Ctrl + G"; }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 0px;
                        GuideSectionTitle { unit: root.ui-unit; text: @tr("SETTINGS_NAV_PLAYER" => "Player"); }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_PLAY_PAUSE" => "Play / Pause"); keys: "Space"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_SEEK_FORWARD" => "Seek forward"); keys: "→ / Shift + →"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_SEEK_BACKWARD" => "Seek backward"); keys: "← / Shift + ←"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_VOLUME" => "Volume"); keys: "↑ / ↓"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_MUTE" => "Mute"); keys: "M"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_SUBTITLES_SIZE" => "Subtitle size"); keys: "- / ="; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_SUBTITLES_DELAY" => "Subtitle delay"); keys: "G / H"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_PLAYBACK_SPEED" => "Playback speed"); keys: "[ / ]"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_TOGGLE_SUBTITLES" => "Toggle subtitles"); keys: "C"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_MENU_SUBTITLES" => "Subtitles menu"); keys: "S"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_MENU_AUDIO" => "Audio menu"); keys: "A"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_MENU_INFO" => "Info menu"); keys: "I"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_MENU_PLAYBACK_SPEED" => "Playback speed menu"); keys: "R"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_MENU_STATISTICS" => "Statistics menu"); keys: "D"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_PLAY_NEXT" => "Play next"); keys: "Shift + N"; }
                        GuideRow { unit: root.ui-unit; label: @tr("SETTINGS_SHORTCUT_EXIT_BACK" => "Exit / Back"); keys: "Esc"; }
                    }
                }
            }
        }

        gamepad-dialog := ModalDialog {
            width: 100%;
            height: 100%;
            z: 2100;
            unit: root.ui-unit;
            open: root.gamepad-modal-open;
            title: @tr("GAMEPAD_CONTROLS_TITLE" => "Gamepad controls");
            dialog-width: 72 * root.ui-unit;
            dialog-height: 45 * root.ui-unit;
            close-requested => {
                root.gamepad-modal-open = false;
                app-shortcuts.focus();
            }

            VerticalLayout {
                spacing: 2 * root.ui-unit;

                Rectangle {
                    height: 15 * root.ui-unit;
                    background: transparent;

                    controller := Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: root.ui-unit;
                        width: 26 * root.ui-unit;
                        height: 12 * root.ui-unit;
                        border-radius: 5 * root.ui-unit;
                        background: Theme.overlay;
                        border-width: 1px;
                        border-color: Theme.text-primary.with-alpha(0.15);

                        Rectangle { x: 4 * root.ui-unit; y: 5.2 * root.ui-unit; width: 5 * root.ui-unit; height: 1.2 * root.ui-unit; border-radius: 0.25 * root.ui-unit; background: Theme.text-secondary; }
                        Rectangle { x: 5.9 * root.ui-unit; y: 3.3 * root.ui-unit; width: 1.2 * root.ui-unit; height: 5 * root.ui-unit; border-radius: 0.25 * root.ui-unit; background: Theme.text-secondary; }
                        for point[index] in [0, 1, 2, 3] : Rectangle {
                            x: (index == 0 || index == 3) ? 20 * root.ui-unit : (index == 1 ? 18.2 * root.ui-unit : 21.8 * root.ui-unit);
                            y: index == 0 ? 3.2 * root.ui-unit : (index == 3 ? 6.8 * root.ui-unit : 5 * root.ui-unit);
                            width: 1.6 * root.ui-unit;
                            height: 1.6 * root.ui-unit;
                            border-radius: self.width / 2;
                            background: index == 0 ? Theme.accent : Theme.text-secondary;
                        }
                        Rectangle { x: 9.5 * root.ui-unit; y: 7.5 * root.ui-unit; width: 3 * root.ui-unit; height: 3 * root.ui-unit; border-radius: self.width / 2; background: Theme.surface-light; }
                        Rectangle { x: 14 * root.ui-unit; y: 7.5 * root.ui-unit; width: 3 * root.ui-unit; height: 3 * root.ui-unit; border-radius: self.width / 2; background: Theme.surface-light; }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    horizontal-scrollbar-policy: always-off;
                    mouse-drag-pan-enabled: true;

                    HorizontalLayout {
                        width: parent.width;
                        spacing: 4 * root.ui-unit;
                        alignment: start;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 0px;
                            GuideSectionTitle { unit: root.ui-unit; text: @tr("GAMEPAD_SECTION_NAVIGATION" => "Navigation"); }
                            GuideRow { unit: root.ui-unit; label: @tr("GAMEPAD_ACTION_NAVIGATE" => "Navigate"); keys: "L stick"; }
                            GuideRow { unit: root.ui-unit; label: @tr("GAMEPAD_ACTION_SELECT" => "Select"); keys: "A / ✕"; }
                            GuideRow { unit: root.ui-unit; label: @tr("GAMEPAD_ACTION_BACK" => "Back"); keys: "B / ○"; }
                            GuideRow { unit: root.ui-unit; label: @tr("GAMEPAD_ACTION_FULLSCREEN" => "Fullscreen"); keys: "Y / △"; }
                            GuideRow { unit: root.ui-unit; label: @tr("GAMEPAD_ACTION_GUIDE" => "Guide"); keys: "X / □"; }
                            GuideRow { unit: root.ui-unit; label: @tr("GAMEPAD_ACTION_PREV_TAB" => "Previous tab"); keys: "LB / L1"; }
                            GuideRow { unit: root.ui-unit; label: @tr("GAMEPAD_ACTION_NEXT_TAB" => "Next tab"); keys: "RB / R1"; }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 0px;
                            GuideSectionTitle { unit: root.ui-unit; text: @tr("GAMEPAD_SECTION_PLAYER" => "Player"); }
                            GuideRow { unit: root.ui-unit; label: @tr("GAMEPAD_ACTION_PLAY_PAUSE" => "Play / Pause"); keys: "X / □"; }
                            GuideRow { unit: root.ui-unit; label: @tr("GAMEPAD_ACTION_SEEK_BACK" => "Seek backward"); keys: "R stick ←"; }
                            GuideRow { unit: root.ui-unit; label: @tr("GAMEPAD_ACTION_SEEK_FWD" => "Seek forward"); keys: "R stick →"; }
                            GuideRow { unit: root.ui-unit; label: @tr("GAMEPAD_ACTION_VOL_UP" => "Volume up"); keys: "R stick ↑"; }
                            GuideRow { unit: root.ui-unit; label: @tr("GAMEPAD_ACTION_VOL_DOWN" => "Volume down"); keys: "R stick ↓"; }
                        }
                    }
                }
            }
        }

        update-dialog := ModalDialog {
            width: 100%;
            height: 100%;
            z: 2000;
            unit: root.ui-unit;
            open: root.update-dialog-open;
            title: @tr("UPDATER_TITLE" => "A new version of Stremio is available");
            dialog-width: 42 * root.ui-unit;
            dialog-height: 34 * root.ui-unit;
            actions: [
                {
                    id: "later",
                    label: @tr("BUTTON_UPDATE_LATTER" => "Not now"),
                    icon: @image-url("assets/images/icons/close.svg"),
                    has-icon: false,
                    enabled: !root.update-installing,
                    primary: false,
                },
                {
                    id: "install",
                    label: root.update-installing
                        ? @tr("Updating…")
                        : (root.update-dialog-can-install
                            ? @tr("UPDATER_INSTALL_BUTTON" => "Install now")
                            : @tr("View on GitHub")),
                    icon: @image-url("assets/images/icons/download.svg"),
                    has-icon: true,
                    enabled: !root.update-installing,
                    primary: true,
                },
            ];
            close-requested => {
                if (!root.update-installing) {
                    root.update-dialog-open = false;
                    root.update-dismiss();
                }
            }
            action-triggered(action) => {
                if (action == "install") {
                    root.update-install();
                } else {
                    root.update-dialog-open = false;
                    root.update-dismiss();
                }
            }

            VerticalLayout {
                spacing: root.ui-unit;

                Text {
                    text: @tr("Stremio v{} is ready to install", root.update-dialog-version);
                    color: Theme.text-primary;
                    font-size: 1.15 * root.ui-unit;
                    font-weight: 700;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 1px;
                    background: Theme.overlay;
                }

                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    horizontal-scrollbar-policy: always-off;
                    mouse-drag-pan-enabled: true;

                    StyledText {
                        width: parent.width;
                        text: root.update-dialog-notes;
                        default-color: Theme.text-primary;
                        default-font-size: 0.9 * root.ui-unit;
                    }
                }

                if (root.update-dialog-status-state != 0) : Text {
                    text: root.update-dialog-status-state == 1
                        ? @tr("Downloading Stremio v{}…", root.update-dialog-version)
                        : (root.update-dialog-status-state == 2
                            ? @tr("Could not open the GitHub release page.")
                            : @tr("The update could not be downloaded or launched."));
                    color: root.update-installing ? Theme.accent : Theme.danger;
                    font-size: 0.85 * root.ui-unit;
                    font-weight: 600;
                    wrap: word-wrap;
                }
            }
        }

        onboarding-dialog := OnboardingModal {
            width: 100%;
            height: 100%;
            unit: root.ui-unit;
            open: root.onboarding-dialog-open;
            changelog-text: root.onboarding-changelog-text;
            available-languages: root.settings-interface-language-options;
            selected-upscaler-preset: root.player-active-shader-preset;
            upscaler-preset-available: root.player-shader-preset-available;
            upscaler-status: root.player-shader-status;
            hardware-acceleration-enabled: root.settings-hardware-acceleration;
            auto-subtitles-enabled: root.settings-subtitles-auto-select;
            discord-rpc-enabled: root.settings-discord-rpc-enabled;
            background-playback-enabled: root.settings-play-in-background;
            seeding-enabled: root.settings-streaming-seeding;
            pause-on-minimize-enabled: root.settings-pause-on-minimize;
            completed => {
                root.onboarding-dialog-open = false;
                root.onboarding-completed();
            }
            skip => {
                root.onboarding-dialog-open = false;
                root.onboarding-completed();
            }
            language-changed(idx) => {
                if (idx >= 0 && idx < root.settings-interface-language-options.length) {
                    root.settings-interface-language = root.settings-interface-language-options[idx];
                    root.settings-change-interface-language(root.settings-interface-language-options[idx]);
                }
            }
            upscaler-changed(idx) => {
                root.player-change-shader-preset(idx);
            }
            seek-duration-changed(dur) => {
                root.settings-seek-duration = round(dur) + "";
                root.settings-change-seek-duration(round(dur) + "");
            }
            toggle-hwdec(enabled) => {
                root.settings-hardware-acceleration = enabled;
                root.settings-change-hardware-acceleration(enabled);
            }
            toggle-auto-subtitles(enabled) => {
                root.settings-subtitles-auto-select = enabled;
                root.settings-change-subtitles-auto-select(enabled);
            }
            toggle-discord-rpc(enabled) => {
                root.settings-discord-rpc-enabled = enabled;
                root.settings-change-discord-rpc-enabled(enabled);
            }
            toggle-background-playback(enabled) => {
                root.settings-play-in-background = enabled;
                root.settings-change-play-in-background(enabled);
            }
            toggle-seeding(enabled) => {
                root.settings-streaming-seeding = enabled;
                root.settings-change-seeding-enabled(enabled);
            }
            toggle-pause-on-minimize(enabled) => {
                root.settings-pause-on-minimize = enabled;
                root.settings-change-pause-on-minimize(enabled);
            }
            open-github-requested => {
                root.open-external-url("https://github.com/stremio/stremio-shell");
            }
        }

    }

    if (root.debug-preview-enabled) : AppDebugMenu {
        x: root.debug-menu-open ? root.ui-unit : (root.effective-show-player ? root.ui-unit : (Theme.vertical-nav-bar-size - self.width) / 2);
        y: root.effective-show-player ? 4.5 * root.ui-unit : parent.height - self.height - root.ui-unit;
        unit: root.ui-unit;
        pages: root.debug-pages;
        states: root.debug-state-options;
        selected-page: root.debug-preview-page;
        selected-state: root.debug-preview-state;
        open <=> root.debug-menu-open;
        page-selected(page) => {
            root.profile-menu-open = false;
            root.debug-preview-page = page;
            root.debug-preview-state = page == -1 ? "login"
                : (page == 0 ? "loaded"
                : (page == 1 ? "catalog"
                : (page == 2 ? "loaded"
                : (page == 3 ? "loaded"
                : (page == 4 ? "general"
                : (page == 5 ? "loaded"
                : (page == 6 ? "results"
                : (page == 7 ? "series-episodes" : "paused"))))))));
        }
        state-selected(state) => {
            root.profile-menu-open = root.debug-preview-page == 0 && state == "profile-menu";
            root.onboarding-dialog-open = state == "onboarding-modal";
            root.update-dialog-open = state == "update-dialog";
            if (state == "update-dialog") {
                root.update-dialog-version = "5.0.0";
                root.update-dialog-notes = @markdown("* **GPU 4K Upscaler Shaders**: Integrated Anime4K (HQ) & AMD FSR spatial upscaler presets.\n* **ThumbFast Seek Bar Preview**: Hover over seek bar for real-time video thumbnail frames.\n* **High-Performance Rust Engine**: libmpv 60fps rendering, hardware acceleration (D3D11VA).\n* **Discord Rich Presence & Seeding**: Live status broadcast on Discord.");
            }
            root.debug-preview-state = state;
            if (root.debug-preview-page == 8) {
                root.player-controls-visible = state != "controls-hidden";
                root.player-show-subtitles-menu = state == "subtitles";
                root.player-show-audio-menu = state == "audio";
                root.player-show-speed-menu = state == "speed";
                root.player-show-stats-menu = state == "stats";
                root.player-show-options-menu = state == "options";
                root.player-show-context-menu = state == "context-menu";
                root.player-show-playlist-drawer = state == "episodes";
            }
        }
    }
}
