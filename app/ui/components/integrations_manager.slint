import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { PillButton } from "button.slint";
import { SelectField } from "select.slint";
import { SettingsOption } from "settings_option.slint";
import { NativeTextField } from "text_input.slint";

export component IntegrationsManager inherits VerticalLayout {
    in property <length> unit: 16px;
    in property <[string]> configured: [];
    in property <string> status: "";
    in-out property <string> provider: "Real-Debrid";
    in-out property <bool> provider-open: false;
    in-out property <string> secret: "";
    in-out property <string> endpoint: "";
    in-out property <string> chat-id: "";
    callback configure(string, string, string, string);
    callback disconnect(string);
    callback close;

    in-out property <bool> show-secret: false;
    private property <bool> notification: root.provider == "Webhook" || root.provider == "Telegram";
    spacing: 0;

    for item in root.configured : SettingsOption {
        unit: root.unit;
        label: item;
        description: @tr("Connected integration provider.");
        PillButton {
            width: 16 * root.unit;
            unit: root.unit;
            label: @tr("Disconnect");
            outlined: true;
            clicked => { root.disconnect(item); }
        }
    }

    SettingsOption {
        unit: root.unit;
        label: @tr("Add Integration");
        description: @tr("Select Debrid, metadata, or notification provider.");
        SelectField {
            width: 100%;
            field-width: 16 * root.unit;
            unit: root.unit;
            value: root.provider;
            options: ["Real-Debrid", "AllDebrid", "Premiumize", "Debrid-Link", "TorBox", "TMDB", "OMDb", "MDBList", "Fanart.tv", "RPDB", "Webhook", "Telegram"];
            open: root.provider-open;
            toggle => { root.provider-open = !root.provider-open; }
            selected(value) => {
                root.provider = value;
                root.provider-open = false;
                root.secret = "";
                root.endpoint = "";
                root.chat-id = "";
                root.show-secret = false;
            }
        }
    }

    if (root.provider == "Webhook") : SettingsOption {
        unit: root.unit;
        label: @tr("Webhook Endpoint URL");
        description: @tr("URL endpoint to receive HTTP webhook payloads.");
        NativeTextField {
            unit: root.unit;
            width: 16 * root.unit;
            text <=> root.endpoint;
            placeholder-text: @tr("https://example.com/webhook");
        }
    }

    if (root.provider == "Telegram") : SettingsOption {
        unit: root.unit;
        label: @tr("Telegram Chat ID");
        description: @tr("Target chat or channel ID for notifications.");
        NativeTextField {
            unit: root.unit;
            width: 16 * root.unit;
            text <=> root.chat-id;
            placeholder-text: @tr("e.g. 123456789");
        }
    }

    SettingsOption {
        unit: root.unit;
        label: root.provider == "Telegram" ? @tr("Bot Token") : (root.provider == "Webhook" ? @tr("Secret Token (Optional)") : @tr("API Key or Secret Token"));
        description: @tr("Provider credentials stored securely in OS vault.");
        HorizontalLayout {
            width: 16 * root.unit;
            spacing: root.unit * 0.5;
            NativeTextField {
                unit: root.unit;
                width: 11 * root.unit;
                text <=> root.secret;
                input-type: root.show-secret ? InputType.text : InputType.password;
                placeholder-text: @tr("Enter API key");
            }
            PillButton {
                unit: root.unit;
                width: 4.5 * root.unit;
                label: root.show-secret ? @tr("Hide") : @tr("Show");
                outlined: true;
                clicked => { root.show-secret = !root.show-secret; }
            }
        }
    }

    SettingsOption {
        unit: root.unit;
        label: @tr("Connect Provider");
        description: root.status != "" ? root.status : @tr("Authenticate and verify integration credentials.");
        PillButton {
            width: 16 * root.unit;
            unit: root.unit;
            label: @tr("Connect and test");
            outlined: true;
            enabled: root.secret != "" || (root.provider == "Webhook" && root.endpoint != "");
            clicked => {
                root.configure(root.provider, root.secret, root.endpoint, root.chat-id);
                root.secret = "";
                root.endpoint = "";
                root.chat-id = "";
                root.show-secret = false;
            }
        }
    }
}
